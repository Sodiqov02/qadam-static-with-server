API_BASE_URL=http://127.0.0.1:8000
QADAM_API_BASE_URL=http://127.0.0.1:8000
# Required for Telegram admin links; use the externally reachable HTTPS origin.
PUBLIC_BASE_URL=https://qadam.example.com
ADMIN_SECRET=replace_with_strong_random_secret
# Local Compose default. Production Compose overrides this with its PostgreSQL service.
DATABASE_URL=sqlite:////data/qadam.db
POSTGRES_DB=qadam
POSTGRES_USER=qadam
POSTGRES_PASSWORD=replace_with_url_safe_random_password
QADAM_DOMAIN=example.com
PORT=8000
UPLOADS_DIR=/data/uploads
MENU_IMAGES_DIR=/data/menu_images
